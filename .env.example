# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://examarena:examarena_secret@localhost:5432/examarena?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# JWT
JWT_SECRET=drpzet
JWT_EXPIRY_HOURS=24

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
# Logging: debug | info | warn | error (default info).
# debug also shows /health checks and CORS preflight requests.
LOG_LEVEL=info

# Question generator: generated Math & Reasoning questions, stored and
# rotated in the questions table alongside hand-written ones.
QUESTION_GEN_ENABLED=true
# Generated questions kept per category (split across easy/medium/hard).
QUESTION_GEN_POOL_SIZE=600
# Hours between pool rotations (25% of each pool replaced each time).
QUESTION_GEN_ROTATE_HOURS=6
# Cap on published questions: players × this, split evenly across categories
# (guests/admins don't count). Beyond it the OLDEST questions are archived,
# hand-written or generated. 0 = no cap.
QUESTION_GEN_PER_USER=100

# Sign-in (internal/auth)
GOOGLE_CLIENT_ID=
# Email codes via resend.com. With a key, email verification is required.
RESEND_API_KEY=
MAIL_FROM=Mind Race <noreply@mindrace.in>
# EMAIL_VERIFICATION=required   # or off; default: required when RESEND_API_KEY is set
